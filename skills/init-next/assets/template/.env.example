# Local PostgreSQL started by compose.yaml. Match the port to POSTGRES_PORT if changed.
DATABASE_URL=postgresql://app:local-password@127.0.0.1:5432/app

# Public origin of the app. Use the HTTPS origin in production.
BETTER_AUTH_URL=http://localhost:3000
# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
