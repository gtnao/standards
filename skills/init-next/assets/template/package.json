{
  "name": "__PROJECT_NAME__",
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.6",
    "@hookform/resolvers": "5.9.1",
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@tabler/icons-react": "3.48.0",
    "better-auth": "1.7.6",
    "next": "16.3.6",
    "next-intl": "4.14.7",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "zod": "4.6.5"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.7.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm run db:generate && next dev",
    "build": "pnpm run db:generate && next build",
    "start": "next start",
    "typecheck": "pnpm run db:generate && next typegen && tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --create-only",
    "db:deploy": "prisma migrate deploy",
    "auth:generate": "auth generate --config ./auth.schema.config.ts --adapter prisma --dialect postgresql",
    "auth:create-admin": "auth create-admin --config ./auth.admin.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@next/env": "16.3.6",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.6",
    "babel-plugin-react-compiler": "1.0.0",
    "postcss": "8.5.28",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prisma": "7.9.1",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
